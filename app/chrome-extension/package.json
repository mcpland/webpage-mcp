{
  "name": "webpage-mcp-connector",
  "description": "A chrome extension connector to use your own webpage as a mcp server",
  "author": "unadlib",
  "private": true,
  "version": "0.9.0",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "build": "pnpm run verify:ort && wxt build && pnpm run verify:bundle",
    "zip": "pnpm run verify:ort && wxt zip && pnpm run verify:bundle && node ./scripts/rename-zip.mjs chrome",
    "verify:ort": "node ./scripts/ort-artifacts.mjs verify",
    "verify:bundle": "node ./scripts/bundle-code-policy.mjs .output/chrome-mv3",
    "copy:ort": "node ./scripts/ort-artifacts.mjs copy",
    "compile": "tsc --noEmit",
    "i18n:check": "node ./scripts/validate-i18n.mjs",
    "postinstall": "wxt prepare",
    "lint": "npx eslint . && pnpm run i18n:check",
    "lint:fix": "npx eslint . --fix",
    "format": "npx prettier --write .",
    "format:check": "npx prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@eslint-community/regexpp": "^4.12.2",
    "@modelcontextprotocol/sdk": "1.29.0",
    "@xenova/transformers": "^2.17.2",
    "@xyflow/react": "^12.10.1",
    "date-fns": "^4.1.0",
    "elkjs": "^0.11.0",
    "gifenc": "^1.0.3",
    "hnswlib-wasm-static": "0.8.5",
    "markstream-react": "0.0.20-beta.7",
    "onnxruntime-web": "1.22.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "webpage-mcp-shared": "workspace:*",
    "zod": "^3.24.4"
  },
  "devDependencies": {
    "@iconify-json/lucide": "^1.1.0",
    "@tailwindcss/vite": "^4.0.0",
    "@types/chrome": "^0.0.318",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitest/coverage-v8": "^3.2.7",
    "@wxt-dev/module-react": "^1.0.2",
    "dotenv": "^16.5.0",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^26.0.0",
    "tailwindcss": "^4.0.0",
    "vite-plugin-static-copy": "^3.0.0",
    "vitest": "^3.2.6",
    "wxt": "^0.20.0"
  }
}
