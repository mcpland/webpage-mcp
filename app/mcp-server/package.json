{
  "name": "webpage-mcp",
  "version": "0.3.1",
  "description": "Webpage MCP server",
  "main": "dist/index.js",
  "bin": {
    "webpage-mcp": "./dist/cli.js",
    "webpage-mcp-stdio": "./dist/mcp/mcp-server-stdio.js"
  },
  "scripts": {
    "dev": "nodemon --watch src --ext ts,js,json --ignore dist/ --exec \"npm run build && npm run register:dev\"",
    "build": "tsup --config tsup.config.ts && node scripts/postbuild.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint 'src/**/*.{js,ts}'",
    "lint:fix": "eslint 'src/**/*.{js,ts}' --fix",
    "format": "prettier --write 'src/**/*.{js,ts,json}'",
    "register:dev": "node dist/scripts/register-dev.js",
    "postinstall": "node -e \"const fs=require('fs');const cp=require('child_process');const dist='dist/scripts/postinstall.js';if(!fs.existsSync(dist)){console.log('Skipping mcp-server postinstall in source workspace (dist not found).');process.exit(0);}const r=cp.spawnSync(process.execPath,[dist],{stdio:'inherit'});if(r.error)throw r.error;process.exit(r.status??1);\""
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "homepage": "https://github.com/mcpland/webpage-mcp#readme",
  "bugs": {
    "url": "https://github.com/mcpland/webpage-mcp/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/mcpland/webpage-mcp.git",
    "directory": "app/mcp-server"
  },
  "files": [
    "dist",
    "!dist/node_path.txt"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "preferGlobal": true,
  "keywords": [
    "mcp",
    "chrome",
    "browser"
  ],
  "author": "unadlib",
  "license": "MIT",
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.1.69",
    "@modelcontextprotocol/sdk": "^1.11.0",
    "better-sqlite3": "^11.6.0",
    "chalk": "^5.4.1",
    "chrome-devtools-frontend": "^1.0.1299282",
    "commander": "^13.1.0",
    "drizzle-orm": "^0.38.2",
    "is-admin": "^4.0.0",
    "pino": "^9.6.0",
    "uuid": "^11.1.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/chrome": "^0.0.318",
    "@types/node": "^22.15.3",
    "@typescript-eslint/parser": "^8.31.1",
    "@vitest/coverage-v8": "^2.1.9",
    "cross-env": "^7.0.3",
    "husky": "^9.1.7",
    "lint-staged": "^15.5.1",
    "nodemon": "^3.1.10",
    "pino-pretty": "^13.0.0",
    "rimraf": "^6.0.1",
    "tsup": "^8.4.0",
    "vitest": "^2.1.8",
    "webpage-mcp-shared": "workspace:*"
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged"
    }
  },
  "lint-staged": {
    "*.{js,ts}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md}": [
      "prettier --write"
    ]
  }
}
