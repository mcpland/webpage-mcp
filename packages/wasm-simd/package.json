{
  "name": "@webpage-mcp/wasm-simd",
  "version": "0.1.0",
  "description": "SIMD-optimized WebAssembly math functions for Webpage MCP",
  "type": "module",
  "main": "pkg/simd_math.js",
  "types": "pkg/simd_math.d.ts",
  "files": [
    "pkg/"
  ],
  "scripts": {
    "build": "node ./scripts/wasm-artifacts.mjs sync",
    "build:dev": "wasm-pack build --target web --out-dir pkg --out-name simd_math --dev --locked --no-pack",
    "clean": "rimraf pkg/",
    "copy:artifacts": "node ./scripts/wasm-artifacts.mjs copy",
    "test": "cargo test --locked",
    "verify:artifacts": "node ./scripts/wasm-artifacts.mjs verify"
  },
  "keywords": [
    "wasm",
    "simd",
    "webassembly",
    "math",
    "cosine-similarity",
    "vector-operations"
  ],
  "author": "unadlib",
  "license": "MIT",
  "devDependencies": {
    "rimraf": "^5.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mcpland/webpage-mcp.git",
    "directory": "packages/wasm-simd"
  }
}
