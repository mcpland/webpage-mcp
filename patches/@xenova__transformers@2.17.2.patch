+    uint64: BigUint64Array,
+    bool: Uint8Array,
+});
 
-/** @type {import('onnxruntime-web')} The ONNX runtime module. */
-export let ONNX;
+class TokenizerTensor {
+    constructor(type, data, dims) {
+        const ExpectedData = DATA_TYPE_CONSTRUCTORS[type];
+        if (!ExpectedData) {
+            throw new TypeError(`Unsupported tokenizer tensor type: ${String(type)}`);
+        }
+        if (!(data instanceof ExpectedData)) {
+            throw new TypeError(`Tokenizer tensor data does not match type ${type}`);
+        }
+        if (!Array.isArray(dims) || dims.some(x => !Number.isSafeInteger(x) || x < 0)) {
+            throw new TypeError('Tokenizer tensor dimensions must be non-negative integers');
+        }
 
-export const executionProviders = [
-    // 'webgpu',
-    'wasm'
-];
+        const size = dims.reduce((product, value) => product * value, 1);
+        if (!Number.isSafeInteger(size) || size !== data.length) {
+            throw new RangeError('Tokenizer tensor dimensions do not match its data length');
+        }
 
-if (typeof process !== 'undefined' && process?.release?.name === 'node') {
-    // Running in a node-like environment.
-    ONNX = ONNX_NODE.default ?? ONNX_NODE;
-
-    // Add `cpu` execution provider, with higher precedence that `wasm`.
-    executionProviders.unshift('cpu');
-
-} else {
-    // Running in a browser-environment
-    ONNX = ONNX_WEB.default ?? ONNX_WEB;
-
-    // SIMD for WebAssembly does not operate correctly in some recent versions of iOS (16.4.x).
-    // As a temporary fix, we disable it for now.
-    // For more information, see: https://github.com/microsoft/onnxruntime/issues/15644
-    const isIOS = typeof navigator !== 'undefined' && /iP(hone|od|ad).+16_4.+AppleWebKit/.test(navigator.userAgent);
-    if (isIOS) {
-        ONNX.env.wasm.simd = false;
+        // Match the enumerable surface used by Transformers.js 2.17's Tensor
+        // wrapper and by webpage-mcp's tokenizer consumer.
+        this.dims = [...dims];
+        this.type = type;
+        this.data = data;
+        this.size = size;
     }
 }
+
+export const ONNX = Object.freeze({
+    Tensor: TokenizerTensor,
+    // env.js reads this field, but webpage-mcp does not use Transformers.js for
+    // inference. Omitting `wasm` ensures no remote executable path is created.
+    env: Object.freeze({}),
+});
+
+export const executionProviders = Object.freeze([]);
